# No secrets are needed for the clearly labelled snapshot demo.
# Copy to .env.local. Never commit .env.local.

# Server-only browser origin allowlist; empty keeps loopback-only browser POSTs.
# Comma-separated exact HTTPS origins, without trailing slashes or paths.
# HTTP is accepted only for explicit loopback/private LAN IP origins.
SPOT_ALLOWED_ORIGINS=
# For npm run local/demo, set these in the shell/service environment before launch.
# Bind defaults to loopback; do not expose Next or Ollama directly to the internet.
SPOT_HOST=127.0.0.1
PORT=3000

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Collector only, never used for public requests.
SUPABASE_SECRET_KEY=
# Remote writes require explicit approval for this exact host.
SPOT_APPROVED_DATABASE_HOST=

# Only loopback Ollama endpoints are accepted. No cloud model billing.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:0.6b
OLLAMA_EMBED_MODEL=embeddinggemma

# Public low-volume pedestrian routing; false disables all route requests.
ROUTING_ENABLED=true

# Без ключей и расходов: детерминированное demo по реальным POI.
APP_MODE=demo
APP_TIMEZONE=Asia/Almaty
LLM_PRIMARY_PROVIDER=ollama
LLM_FALLBACK_PROVIDER=none
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIMENSIONS=768
RETRIEVAL_PROVIDER=local

# Только для отдельного разрешённого live-запуска. Ключ сам по себе не разрешает вызовы.
ALLOW_LIVE_API=false
ALLOW_PROVIDER_FAILOVER=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm4.7
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AI_RUN_ID=
AI_AUTHORIZED_UNTIL=
AI_RUN_BUDGET_USD=
AI_DAILY_BUDGET_USD=
AI_MAX_REQUESTS_PER_RUN=
AI_MAX_OUTPUT_TOKENS=1000
AI_REQUEST_TIMEOUT_MS=20000
# Задать проверенные верхние ставки вручную, пустые значения блокируют облачные вызовы.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
NVIDIA_INPUT_USD_PER_MILLION=
NVIDIA_OUTPUT_USD_PER_MILLION=
